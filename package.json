{
  "name": "@root/yesimbot",
  "private": true,
  "homepage": "github:HydroGest/YesImBot",
  "license": "MIT",
  "contributors": [
    "HydroGest <2445691453@qq.com>",
    "Dispure <3116716016@qq.com>",
    "MiaowFISH <1293865264@qq.com>",
    "Touch-Night <1762918301@qq.com>"
  ],
  "workspaces": [
    "core",
    "packages/*",
    "platforms/*",
    "plugins/*",
    "providers/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "clean": "yakumo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "setup-koishi": "node scripts/setup-koishi.mjs",
    "setup-koishi:check": "node scripts/setup-koishi.mjs --check",
    "test": "yakumo vitest"
  },
  "devDependencies": {
    "@koishijs/core": "^4.18.11",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yakumo": "^3.2.1",
    "yakumo-esbuild": "^3.0.2",
    "yakumo-tsc": "^3.0.1",
    "yakumo-vitest": "^1.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
