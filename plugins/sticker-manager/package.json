{
  "name": "koishi-plugin-yesimbot-sticker-manager",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npx pkgroll",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "pub": "yarn npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ai": "^6.0.0",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/omggif": "^1",
    "@types/pngjs": "^6.0.5",
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "zod": "^3.25.76"
  },
  "koishi": {
    "description": {
      "zh": "表情包收藏、分类、导入和管理",
      "en": "Sticker collection, classification, import and management"
    },
    "service": {
      "required": [
        "yesimbot",
        "database"
      ]
    }
  }
}
