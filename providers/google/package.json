{
  "name": "@yesimbot/koishi-plugin-provider-google",
  "version": "0.0.1",
  "description": "YesImBot Google model provider plugin",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/YesImBot/issues"
  },
  "license": "MIT",
  "contributors": [
    "MiaowFISH <miaowfish@qq.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/YesImBot.git",
    "directory": "providers/google"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npx pkgroll --sourcemap=inline",
    "check-types": "tsc --noEmit",
    "clean": "rimraf .turbo && rimraf dist && rimraf tsconfig.tsbuildinfo",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "pub": "yarn npm publish --access public"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.111"
  },
  "devDependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^",
    "zod": "^3.25.76"
  },
  "koishi": {
    "description": {
      "zh": "Google 模型提供商插件（支持 Gemini 系列模型与嵌入）",
      "en": "Google model provider plugin (Gemini models with embeddings)"
    },
    "service": {
      "required": [
        "yesimbot"
      ]
    }
  }
}
