{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".planning", "dist", "docs", "openspec", "references"],
  "experimentalSortImports": {
    "order": "asc"
  },
  "experimentalSortPackageJson": {
    "sortScripts": true
  },
  "endOfLine": "lf",
  "semi": true,
  "printWidth": 120,
  "singleQuote": false,
  "insertFinalNewline": true,
  "trailingComma": "all"
}
